{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "react"
    ],
    "paths": {
      "react-dom": [
        "../../runtime/web/node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "../../runtime/web/node_modules/@types/react-dom/*"
      ],
      "@codemirror/commands": [
        "./node_modules/@codemirror/commands"
      ],
      "@codemirror/commands/*": [
        "./node_modules/@codemirror/commands/*"
      ],
      "@codemirror/lang-markdown": [
        "./node_modules/@codemirror/lang-markdown"
      ],
      "@codemirror/lang-markdown/*": [
        "./node_modules/@codemirror/lang-markdown/*"
      ],
      "@codemirror/language": [
        "./node_modules/@codemirror/language"
      ],
      "@codemirror/language/*": [
        "./node_modules/@codemirror/language/*"
      ],
      "@codemirror/language-data": [
        "./node_modules/@codemirror/language-data"
      ],
      "@codemirror/language-data/*": [
        "./node_modules/@codemirror/language-data/*"
      ],
      "@codemirror/merge": [
        "./node_modules/@codemirror/merge"
      ],
      "@codemirror/merge/*": [
        "./node_modules/@codemirror/merge/*"
      ],
      "@codemirror/search": [
        "./node_modules/@codemirror/search"
      ],
      "@codemirror/search/*": [
        "./node_modules/@codemirror/search/*"
      ],
      "@codemirror/state": [
        "./node_modules/@codemirror/state"
      ],
      "@codemirror/state/*": [
        "./node_modules/@codemirror/state/*"
      ],
      "@codemirror/view": [
        "./node_modules/@codemirror/view"
      ],
      "@codemirror/view/*": [
        "./node_modules/@codemirror/view/*"
      ],
      "@lezer/markdown": [
        "./node_modules/@lezer/markdown"
      ],
      "@lezer/markdown/*": [
        "./node_modules/@lezer/markdown/*"
      ],
      "@radix-ui/react-dialog": [
        "../../runtime/web/node_modules/@radix-ui/react-dialog"
      ],
      "@radix-ui/react-dialog/*": [
        "../../runtime/web/node_modules/@radix-ui/react-dialog/*"
      ],
      "@radix-ui/react-slot": [
        "../../runtime/web/node_modules/@radix-ui/react-slot"
      ],
      "@radix-ui/react-slot/*": [
        "../../runtime/web/node_modules/@radix-ui/react-slot/*"
      ],
      "@types/qrcode": [
        "../sdk/node_modules/@types/qrcode"
      ],
      "@types/qrcode/*": [
        "../sdk/node_modules/@types/qrcode/*"
      ],
      "class-variance-authority": [
        "../sdk/node_modules/class-variance-authority"
      ],
      "class-variance-authority/*": [
        "../sdk/node_modules/class-variance-authority/*"
      ],
      "clsx": [
        "../sdk/node_modules/clsx"
      ],
      "clsx/*": [
        "../sdk/node_modules/clsx/*"
      ],
      "dompurify": [
        "./node_modules/dompurify"
      ],
      "dompurify/*": [
        "./node_modules/dompurify/*"
      ],
      "es-module-lexer": [
        "../sdk/node_modules/es-module-lexer"
      ],
      "es-module-lexer/*": [
        "../sdk/node_modules/es-module-lexer/*"
      ],
      "highlight.js": [
        "./node_modules/highlight.js"
      ],
      "highlight.js/*": [
        "./node_modules/highlight.js/*"
      ],
      "katex": [
        "./node_modules/katex"
      ],
      "katex/*": [
        "./node_modules/katex/*"
      ],
      "lucide-react": [
        "../sdk/node_modules/lucide-react"
      ],
      "lucide-react/*": [
        "../sdk/node_modules/lucide-react/*"
      ],
      "marked": [
        "./node_modules/marked"
      ],
      "marked/*": [
        "./node_modules/marked/*"
      ],
      "mermaid": [
        "./node_modules/mermaid"
      ],
      "mermaid/*": [
        "./node_modules/mermaid/*"
      ],
      "motion": [
        "../sdk/node_modules/motion"
      ],
      "motion/*": [
        "../sdk/node_modules/motion/*"
      ],
      "postcss": [
        "../sdk/node_modules/postcss"
      ],
      "postcss/*": [
        "../sdk/node_modules/postcss/*"
      ],
      "qrcode": [
        "../sdk/node_modules/qrcode"
      ],
      "qrcode/*": [
        "../sdk/node_modules/qrcode/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-markdown": [
        "./node_modules/react-markdown"
      ],
      "react-markdown/*": [
        "./node_modules/react-markdown/*"
      ],
      "rehype-highlight": [
        "./node_modules/rehype-highlight"
      ],
      "rehype-highlight/*": [
        "./node_modules/rehype-highlight/*"
      ],
      "rehype-katex": [
        "./node_modules/rehype-katex"
      ],
      "rehype-katex/*": [
        "./node_modules/rehype-katex/*"
      ],
      "rehype-sanitize": [
        "./node_modules/rehype-sanitize"
      ],
      "rehype-sanitize/*": [
        "./node_modules/rehype-sanitize/*"
      ],
      "remark-gfm": [
        "./node_modules/remark-gfm"
      ],
      "remark-gfm/*": [
        "./node_modules/remark-gfm/*"
      ],
      "remark-math": [
        "./node_modules/remark-math"
      ],
      "remark-math/*": [
        "./node_modules/remark-math/*"
      ],
      "tailwind-merge": [
        "../sdk/node_modules/tailwind-merge"
      ],
      "tailwind-merge/*": [
        "../sdk/node_modules/tailwind-merge/*"
      ],
      "yaml": [
        "./node_modules/yaml"
      ],
      "yaml/*": [
        "./node_modules/yaml/*"
      ]
    },
    "noUncheckedSideEffectImports": false,
    "preserveSymlinks": true
  },
  "include": [
    "projects-app.tsx",
    "project-components.tsx",
    "project-view.tsx",
    "references-view.tsx",
    "files-view.tsx",
    "conversation-view.tsx",
    "context-file-editor.tsx"
  ]
}
