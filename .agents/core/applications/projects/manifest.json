{
  "schemaVersion": 1,
  "id": "com.ksf.projects",
  "name": "KSF项目",
  "version": "0.12.0",
  "description": "查看和编辑项目、里程碑与任务的属性及Markdown正文，保留项目目录、上下文文件与原保存机制。",
  "author": "KSF",
  "icon": "package",
  "sdkVersion": 1,
  "backend": {
    "runtime": "node",
    "entry": "backend/index.mjs",
    "lifecycle": "on-demand"
  },
  "permissions": [
    "filesystem",
    "shell",
    "codex-conversations"
  ],
  "window": {
    "entry": "frontend/index.js",
    "styles": [
      "frontend/index.css"
    ],
    "multiInstance": true,
    "defaultSize": {
      "width": 1180,
      "height": 760
    },
    "minSize": {
      "width": 540,
      "height": 420
    }
  },
  "minCoreVersion": "0.6.0",
  "dataStores": [
    {
      "name": "conversations.json",
      "scope": "user",
      "schemaVersion": 1,
      "migrateFrom": []
    },
    {
      "name": "preferences.json",
      "scope": "user",
      "schemaVersion": 1,
      "migrateFrom": []
    },
    {
      "name": "project-briefs.json",
      "scope": "user",
      "schemaVersion": 1,
      "migrateFrom": []
    }
  ],
  "sdkApiVersion": "1.2.0",
  "builtWithSdkVersion": "1.2.0"
}
