{
  "schemaVersion": 1,
  "id": "com.ksf.projects",
  "name": "KSF项目",
  "version": "0.10.108",
  "description": "从目标和阶段成果推进项目，管理工作承诺、依赖、风险、决定与证据验收，保留原始检查点和 Desktop 对话。",
  "author": "KSF",
  "icon": "package",
  "sdkVersion": 1,
  "backend": {
    "runtime": "node",
    "entry": "backend/index.mjs",
    "lifecycle": "on-demand"
  },
  "permissions": [
    "filesystem",
    "shell",
    "codex-conversations"
  ],
  "window": {
    "entry": "frontend/index.js",
    "styles": [
      "frontend/index.css"
    ],
    "multiInstance": true,
    "defaultSize": {
      "width": 1180,
      "height": 760
    },
    "minSize": {
      "width": 540,
      "height": 420
    }
  },
  "minCoreVersion": "0.5.5",
  "dataStores": [
    {
      "name": "conversations.json",
      "scope": "user",
      "schemaVersion": 1,
      "migrateFrom": []
    },
    {
      "name": "preferences.json",
      "scope": "user",
      "schemaVersion": 1,
      "migrateFrom": []
    },
    {
      "name": "project-briefs.json",
      "scope": "user",
      "schemaVersion": 1,
      "migrateFrom": []
    }
  ],
  "sdkApiVersion": "1.1.0",
  "builtWithSdkVersion": "1.1.0"
}
