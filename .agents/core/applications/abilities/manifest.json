{
  "schemaVersion": 1,
  "sdkVersion": 1,
  "id": "com.ksf.abilities",
  "name": "KSF能力",
  "version": "0.2.1",
  "description": "发现、读取、维护和检查现有能力定义，保留有效来源、精确引用与用户派生。",
  "author": "KSF",
  "icon": "abilities",
  "minCoreVersion": "0.5.2",
  "permissions": [
    "filesystem"
  ],
  "dataStores": [],
  "cards": [],
  "window": {
    "entry": "frontend/index.js",
    "multiInstance": true,
    "defaultSize": {
      "width": 980,
      "height": 720
    },
    "minSize": {
      "width": 480,
      "height": 420
    }
  },
  "backend": {
    "runtime": "node",
    "entry": "backend/index.mjs",
    "lifecycle": "on-demand"
  }
