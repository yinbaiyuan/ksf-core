{
  "schemaVersion": 1,
  "sdkVersion": 1,
  "id": "com.ksf.knowledge",
  "name": "KSF知识",
  "version": "0.2.3",
  "description": "浏览、搜索、记录和修订现有知识原文，核对来源与链接并沿实例规则组织。",
  "author": "KSF",
  "icon": "knowledge",
  "minCoreVersion": "0.5.5",
  "permissions": [
    "filesystem"
  ],
  "dataStores": [],
  "cards": [],
  "window": {
    "entry": "frontend/index.js",
    "multiInstance": true,
    "defaultSize": {
      "width": 980,
      "height": 720
    },
    "minSize": {
      "width": 480,
      "height": 420
    }
  },
  "backend": {
    "runtime": "node",
    "entry": "backend/index.mjs",
    "lifecycle": "on-demand"
  },
  "sdkApiVersion": "1.1.0",
  "builtWithSdkVersion": "1.1.0"
}
